# Copy this file to `.env` and adjust values. Docker Compose will pick these up automatically.

# Steam credentials
STEAM_USERNAME=anonymous
# STEAM_PASSWORD=

# Install settings
APP_ID=2131400
INSTALL_DIR=/home/steam/vein
UPDATE_ON_START=true
VALIDATE=false

# Server settings
SERVER_NAME=My VEIN Server
SERVER_PASSWORD=
ADMIN_PASSWORD=
SERVER_PORT=7777
QUERY_PORT=27015
MAX_PLAYERS=16

# Visibility & session settings
SERVER_PUBLIC=true
BIND_ADDR=0.0.0.0
HEARTBEAT_INTERVAL=5.0

# Admin IDs (comma OR newline separated)
# Example:
# ADMIN_STEAM_IDS=76561198000000001,76561198000000002
# Or multi-line:
# ADMIN_STEAM_IDS="76561198000000001\n76561198000000002"
ADMIN_STEAM_IDS=
SUPERADMIN_STEAM_IDS=

# Steam Game Server Login Token (optional) to claim server ownership
# Generate at: https://steamcommunity.com/dev/managegameservers (AppID 1857950)
STEAM_GSLT=

# INI behavior
INI_ENABLE=true
# Multi-line overrides: each line file:section:key=value (file relative to config dir if not absolute)
#INI_EXTRA_OVERRIDES=|
#  Game.ini:/script/engine.gamesession:MaxPlayers=16
#  Game.ini:/script/vein.veingamesession:BindAddr=0.0.0.0

# Graceful shutdown behavior
# Send "/save" to server stdin before stopping, then wait a few seconds
SAVE_ON_SHUTDOWN=true
SAVE_WAIT_SECONDS=5

# Extra runtime flags passed to VeinServer.sh
#EXTRA_ARGS=-log

# Optionally force a specific start command (normally auto-detected)
#START_COMMAND=
